rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /room-assets/{roomId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
