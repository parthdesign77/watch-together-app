rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function roomParticipant(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants;
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId);
      allow update: if isSelf(userId);
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if roomParticipant(roomId);
        allow create: if roomParticipant(roomId) && request.resource.data.userId == request.auth.uid;
        allow update: if roomParticipant(roomId);
        allow delete: if signedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
      }

      match /signals/{signalId} {
        allow read: if roomParticipant(roomId);
        allow create: if roomParticipant(roomId) && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /watchlists/{entryId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /subscriptions/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }
  }
}
